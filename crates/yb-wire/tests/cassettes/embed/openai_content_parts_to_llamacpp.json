    "encoding_format": "float",
    "input": [
      {
        "content": [
          {
            "type": "text",
            "text": "a red bicycle"
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/jpeg;base64,/9j/4AAQSkZJRg=="
